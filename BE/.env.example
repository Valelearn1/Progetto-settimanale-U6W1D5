# Copia questo file in .env e inserisci i tuoi valori reali:
#   cp .env.example .env
# Il file .env e' escluso da git: le credenziali non finiscono mai su GitHub.

# === Database PostgreSQL locale ===
# Il database va creato prima su pgAdmin con questo nome.
DB_URL=jdbc:postgresql://localhost:5432/Progetto-settimanale-U6W1D5
DB_USERNAME=postgres
DB_PASSWORD=1234

# === Mail (Gmail) ===
# Il tuo indirizzo Gmail completo
MAIL_USERNAME=tuonome@gmail.com
# App Password di 16 caratteri generata da Google (NON la password dell'account).
# Si crea su https://myaccount.google.com/apppasswords con la verifica
# in 2 passaggi attiva. Va scritta senza spazi.
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
# Mittente mostrato al destinatario (opzionale, default: MAIL_USERNAME)
MAIL_FROM=tuonome@gmail.com

# === JWT ===
# Generane una tua, minimo 32 caratteri, per esempio con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRATION_MINUTES=120

# === OpenRouter (suggerimenti AI) ===
# Chiave da https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
